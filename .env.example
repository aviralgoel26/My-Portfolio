# ============================================================================================
# Portfolio Microservices — Environment Variables Reference
# ============================================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is listed in .gitignore.
# ============================================================================================

# ─── Active Profile ──────────────────────────────────────────────────────────────────────
# Set to "prod" on Render. Leave as "dev" for local docker-compose development.
SPRING_PROFILES_ACTIVE=dev

# ─── MongoDB ─────────────────────────────────────────────────────────────────────────────
# For local docker-compose, these seed the MongoDB root user.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme_strong_password

# For production (MongoDB Atlas), set a full connection string per service:
# Each service's MONGO_URI points to its own database on Atlas.
# Example: mongodb+srv://user:pass@cluster.mongodb.net/portfolio_auth?retryWrites=true&w=majority
# These are set as individual env vars on each Render service, NOT here.

# ─── JWT ─────────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your_256bit_hex_secret_here_replace_this_immediately
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# ─── Eureka Server URL ───────────────────────────────────────────────────────────────────
# In production, set to your Render Eureka service URL:
# Example: https://eureka-server-xxxx.onrender.com/eureka
EUREKA_SERVER_URL=http://eureka-server:8761/eureka

# ─── Default Admin Account (seeded by auth-service on first start) ───────────────────────
ADMIN_USERNAME=AviralGoel26
ADMIN_PASSWORD=YourStrongPassword@123
ADMIN_EMAIL=youremail@gmail.com

# ─── SMTP / Email ─────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youremail@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_TO_EMAIL=youremail@gmail.com

# ─── Cloudinary (media-service) ───────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Redis (gateway-service rate limiter) ─────────────────────────────────────────────────
# Local docker-compose uses container name "redis"
# Production: Use Upstash Redis — set REDIS_HOST and REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka ────────────────────────────────────────────────────────────────────────────────
# Local docker-compose uses container name "kafka"
# Production: Use Upstash Kafka — set full bootstrap server URL
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── Frontend Gateway URL (for CORS in gateway-service) ──────────────────────────────────
# Set to your deployed Vercel frontend URL
FRONTEND_URL=https://your-portfolio.vercel.app
# Optional alternate origins:
FRONTEND_URL_ALT=http://localhost:3000
FRONTEND_URL_DOCKER=http://localhost:6060
